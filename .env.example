# Database Connection String (Neon PostgreSQL)
# Obtén tu URL de conexión en: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"

# JWT Secret (requerido para login con JWT)
JWT_SECRET=tu-secreto-super-seguro-aqui

# Google OAuth
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Temporary admin bootstrap endpoint
# Set to true only for initial setup, then set back to false
ENABLE_ADMIN_BOOTSTRAP=false
# ADMIN_BOOTSTRAP_TOKEN=define-un-token-largo-y-aleatorio

# Node Environment
# NODE_ENV=development
